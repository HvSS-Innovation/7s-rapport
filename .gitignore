# tills den ev. landar spåras tools/ inte på main.
tools/

stab/*
!stab/Ny mapp/

# Lokala screenshots och tmp-bilder i repo-roten — hör inte till prod
/Screenshot_*.png
/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9]*.png
/*.tmp
/*.bak

# OS-skräp
.DS_Store
Thumbs.db
desktop.ini

# OPSEC-invariant-testet (test/opsec/): playwright installeras --no-save i
# roten, fixturen (6,6 MB binär) hämtas av run.js, .tmp/ är körningsloggar.
/node_modules/
/package.json
/package-lock.json
test/opsec/fixtures/
test/opsec/.tmp/

# Lokala roadmap-anteckningar (innehåller lokal Dropbox-sökväg, ej för publik repo)
/roadmap-*.md

# Claude Code lokal config (permissions, hooks – per maskin, ej för publik repo)
.claude/

# Råa data-källor i repo-roten (parse-input — outputs som ortnamn.json
# versioneras, men källorna är stora och ändras sällan).
raw/
/kriterier.xml
/sjöar.xml
/öar.xml

# Kamera/webcam-experiment i verktyg/ — test-bilder, ad-hoc scripts och
# loggar. Inte del av prod-appen. Om du vill committa en enskild fil:
# använd `git add -f path` eller lägg ett !undantag nedan.
verktyg/*.png
verktyg/*.jpg
verktyg/*.txt
verktyg/*.pdf
verktyg/*.py

# Stoppnota/handoff — lokal sessionsanteckning, ej för publik repo
/HANDOFF.md
